CREATE OR REPLACE FUNCTION update_rating_score() RETURNS TRIGGER AS $$
DECLARE
	movie_id movie.id%TYPE;
	movies varchar(10) ARRAY[2];
	a_rating rating%ROWTYPE;
	score_value rating.score%TYPE;
	total_votes rating.votes%TYPE;
	total_score rating.score%TYPE;
	num_rating integer;
BEGIN
	IF (TG_OP = 'INSERT') THEN
		movies[1]=NEW.movie;
	END IF;
	IF (TG_OP = 'DELETE') THEN
		movies[1]=OLD.movie;
	END IF;
	IF (TG_OP = 'UPDATE') THEN
		movies[1] := OLD.movie;
		IF (OLD.movie <> NEW.movie) THEN
			movies[2] := NEW.movie;
		END IF;
	END IF;
	
	FOREACH movie_id IN ARRAY movies LOOP
		total_score:=0;
		total_votes:=0;
		num_reating:=0;
		FOR a_rating IN SELECT * FROM rating WHERE movie=movie_id AND
		scale<>0
		LOOP
			total_score := total_score + ((a_rating.score / a_rating.scale) * 10) * a_rating.votes;
			total_votes := total_votes + a_rating.votes;
			num_rating := num_rating + 1;
		END LOOP; 
		
		IF total_votes <> 0 THEN
			score_value := total_score / total_votes;
		ELSE
			score_value := 0;
		END IF;
	
	PERFORM * FROM rating WHERE movie=movie_id
	IF FOUND THEN
		UPDATE movie_score SET score=score_value,
		rating_number=num_rating WHERE movie=movie_id
	ELSE
		INSERT INTO movie_score(movie,rating_number,overall_score)
                VALUES (movie_id,num_rating,score_value);
	END IF;

	END LOOP;	
	
	RETURN NULL;


END;
$$ language plpgsql;

CREATE TRIGGER score_update_trigger AFTER INSERT OR UPDATE OR DELETE ON rating
FOR EACH ROW EXECUTE PROCEDURE update_rating_score(); 
		
